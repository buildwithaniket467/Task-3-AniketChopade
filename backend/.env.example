PORT=5000

# --- Option 1: Local MongoDB ---
# Make sure MongoDB is installed and running locally.
# Default local URI (no auth):
MONGO_URI=mongodb://localhost:27017/student_management

# With authentication (if your local MongoDB has a username/password):
# MONGO_URI=mongodb://YOUR_USERNAME:YOUR_PASSWORD@localhost:27017/student_management

# --- Option 2: MongoDB Atlas (Cloud) ---
# 1. Go to https://www.mongodb.com/cloud/atlas and create a free account.
# 2. Create a cluster and a database user.
# 3. Whitelist your IP address (or use 0.0.0.0/0 for all IPs).
# 4. Click "Connect" → "Connect your application" and copy the connection string.
# 5. Replace the MONGO_URI below with your Atlas connection string:
# MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/student_management?retryWrites=true&w=majority
